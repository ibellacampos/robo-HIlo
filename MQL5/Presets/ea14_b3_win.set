JanelaVelas=10||5||5||20||Y
MovimentoMinimoPontos=250||150||50||400||Y
CorpoMinimoReacao=0.5
Contratos=1
EspacamentoGradePontos=70
NiveisMaximos=3
AlvoPontos=100||60||20||200||Y
StopPontos=300
BaseStop=0
TrailingInicioPontos=0
TrailingDistanciaPontos=60
HoraInicio=09:05
HoraFim=16:30
HoraZeragem=17:45
CiclosMaximosDia=0
