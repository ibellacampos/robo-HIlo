; EA14_PrecoReativo - B3 / WIN, grafico M1 (conta NETTING ou HEDGING)
; Valores do video: 10 contratos por entrada, ~70 pts entre entradas, ate 3 entradas.
; Alvo/stop/movimento sao estimativas (o video nao mostra os parametros). NAO testado.
; ATENCAO: 3 x 10 = 30 contratos; stop de 300 pts com 30 contratos = ate R$ 1.800 de perda.
; Comece com Contratos=1 no teste para medir a estrategia.
NumeroMagico=2025
PermitirNoTestador=true
PermitirEmDemo=false
PermitirEmContaReal=false
TempoGrafico=1
PermitirCompras=true
PermitirVendas=true
